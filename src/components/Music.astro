---
import { buttonVariants } from './ui/button';
import { ArrowTopRightIcon } from '@radix-ui/react-icons';

const lastFmProfile = 'https://www.last.fm/user/yyyywaiwai';
const lastFmCard = 'https://www.russ.rest/lastfm-last-played?username=yyyywaiwai&width=900';
const playlist = 'https://music.apple.com/jp/playlist/favorite-songs/pl.u-0JUYxokm3b';
---

<section id="music" class="section-block music-section" aria-labelledby="music-title">
  <div class="section-heading">
    <h2 id="music-title">いつも聴いている音楽</h2>
    <p>Mr.Childrenとラーメンに元気をもらっています。いつもの曲をくり返し聴いています。</p>
  </div>

  <div class="music-grid">
    <div class="listening-panel">
      <div class="listening-heading"><h3>最近聴いた曲</h3><a class="text-link" href={lastFmProfile} target="_blank" rel="noopener noreferrer">Last.fmを見る<ArrowTopRightIcon aria-hidden="true" /></a></div>
      <a class="lastfm-card" href={lastFmProfile} target="_blank" rel="noopener noreferrer" aria-label="Last.fmを見る（現在再生中または最近再生した曲）">
        <span class="lastfm-fallback">Last.fmを見る<ArrowTopRightIcon aria-hidden="true" /></span>
        <img id="lastfm-image" src={lastFmCard} data-card-url={lastFmCard} width="900" height="280" loading="lazy" alt="Last.fmの現在再生中または最近再生した曲" />
      </a>
    </div>

    <div class="playlist-panel">
      <div class="playlist-heading">
        <h3>お気に入りのプレイリスト</h3>
        <span class="playlist-service">Apple Music</span>
      </div>
      <div class="playlist-embed" id="playlist-embed">
        <div class="embed-placeholder" aria-hidden="true"><span></span><span></span><span></span></div>
        <iframe
          id="apple-music-playlist"
          src="https://embed.music.apple.com/jp/playlist/favorite-songs/pl.u-0JUYxokm3b?theme=light"
          title="yyyywaiwaiのApple Musicお気に入りプレイリスト"
          width="660"
          height="450"
          loading="lazy"
          allow="autoplay *; encrypted-media *; fullscreen *; clipboard-write"
          sandbox="allow-forms allow-popups allow-same-origin allow-scripts allow-storage-access-by-user-activation allow-top-navigation-by-user-activation"
        ></iframe>
      </div>
      <a class={buttonVariants({ variant: 'ghost', size: 'sm' })} href={playlist} target="_blank" rel="noopener noreferrer">
        Apple Musicで開く<ArrowTopRightIcon aria-hidden="true" />
      </a>
    </div>
  </div>
</section>

<script>
  const image = document.querySelector<HTMLImageElement>('#lastfm-image');

  if (image) {
    let pendingUrl: string | null = null;
    const showImage = () => { image.hidden = false; };
    const hideImage = () => { image.hidden = true; };
    image.addEventListener('load', showImage);
    image.addEventListener('error', hideImage);
    if (image.complete && image.naturalWidth === 0) hideImage();

    const refresh = () => {
      if (document.visibilityState !== 'visible') return;
      const next = `${image.dataset.cardUrl}&refresh=${Math.floor(Date.now() / 60_000)}`;
      if ((!image.hidden && image.src === next) || pendingUrl === next) return;

      const probe = new Image();
      pendingUrl = next;
      probe.onload = () => {
        if (pendingUrl !== next) return;
        image.src = next;
        image.hidden = false;
        pendingUrl = null;
      };
      probe.onerror = () => {
        if (pendingUrl === next) pendingUrl = null;
      };
      probe.src = next;
    };

    refresh();
    window.setInterval(refresh, 60_000);
    document.addEventListener('visibilitychange', refresh);
  }

  const playlist = document.querySelector<HTMLIFrameElement>('#apple-music-playlist');
  const embed = document.querySelector<HTMLElement>('#playlist-embed');

  if (playlist && embed) {
    const darkMode = window.matchMedia('(prefers-color-scheme: dark)');
    let placeholderTimeout: number;
    const stopLoading = () => {
      delete embed.dataset.loading;
      window.clearTimeout(placeholderTimeout);
    };
    const updateTheme = () => {
      const url = new URL(playlist.src);
      const theme = darkMode.matches ? 'dark' : 'light';
      embed.dataset.loading = 'true';
      window.clearTimeout(placeholderTimeout);
      placeholderTimeout = window.setTimeout(stopLoading, 8_000);
      if (url.searchParams.get('theme') !== theme) {
        url.searchParams.set('theme', theme);
        playlist.src = url.href;
      }
    };

    playlist.addEventListener('load', stopLoading);
    playlist.addEventListener('error', stopLoading);
    darkMode.addEventListener('change', updateTheme);
    updateTheme();
  }
</script>

<style>
  .music-grid { display: grid; grid-template-columns: 0.85fr 1.15fr; gap: 64px; align-items: start; }
  .listening-panel, .playlist-panel { min-width: 0; }
  .listening-heading, .playlist-heading { display: flex; align-items: center; justify-content: space-between; gap: 16px; }
  h3 { font-size: 0.9375rem; font-weight: 500; line-height: 1.6; }
  .lastfm-card { position: relative; display: block; overflow: hidden; aspect-ratio: 900 / 280; margin-top: 12px; border-radius: var(--control-radius); background: var(--muted); }
  .lastfm-fallback { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; gap: 8px; padding: 12px; color: var(--muted-foreground); font-size: 0.8125rem; }
  .lastfm-card img { position: relative; width: 100%; height: 100%; object-fit: cover; background: var(--muted); }
  .lastfm-card img[hidden] { display: none; }
  .playlist-heading { margin-bottom: 24px; min-height: 24px; }
  .playlist-service { color: var(--muted-foreground); font-size: 0.75rem; white-space: nowrap; }
  .playlist-embed { position: relative; overflow: hidden; border-radius: var(--media-radius); background: var(--muted); margin-bottom: 12px; }
  iframe { position: relative; display: block; width: 100%; max-width: 100%; border: 0; }
  .embed-placeholder { position: absolute; inset: 0; display: grid; align-content: start; gap: 16px; padding: 24px; opacity: 0; transition: opacity 180ms ease; pointer-events: none; }
  .embed-placeholder span { display: block; height: 40px; border-radius: var(--control-radius); background: var(--border); }
  .embed-placeholder span:first-child { width: 45%; height: 96px; margin-bottom: 24px; }
  .playlist-embed[data-loading] .embed-placeholder { opacity: 1; }
  @media (min-width: 768px) and (max-width: 1023px) { .music-grid { gap: 32px; } .playlist-heading { align-items: start; flex-direction: column; gap: 4px; } }
  @media (max-width: 767px) { .music-grid { grid-template-columns: 1fr; gap: 36px; } .playlist-heading { margin-bottom: 20px; } }
  @media (prefers-reduced-motion: reduce) { .embed-placeholder { transition: none; } }
</style>
