---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { Card } from './ui/card';
import { Badge } from './ui/badge';
import { buttonVariants } from './ui/button';
import { ArrowTopRightIcon } from '@radix-ui/react-icons';

interface Props {
  title: string;
  description: string;
  image: ImageMetadata;
  siteUrl: string;
  sourceUrl?: string;
  siteLabel?: string;
  tags: string[];
  featured?: boolean;
  index: number;
}
const { title, description, image, siteUrl, sourceUrl, siteLabel = 'サイトを見る', tags, featured = false, index } = Astro.props;
---

<article class:list={['project', { featured }]} aria-labelledby={`project-${index}`}>
  <Card className={`project-card ${featured ? 'featured-card' : ''}`}>
    <a class:list={['project-media', { 'featured-media': featured }]} href={siteUrl} target="_blank" rel="noopener noreferrer" aria-label={`${title}のサイトを新しいタブで開く`} tabindex="-1" aria-hidden="true">
      <Image src={image} alt={`${title}のプロジェクト画像`} widths={featured ? [256, 512] : [480, 960]} sizes={featured ? '240px' : '(max-width: 767px) calc(100vw - 40px), 560px'} loading="lazy" decoding="async" />
    </a>
    <div class="project-content">
      <div class="project-tags">{tags.map((tag) => <Badge variant="secondary" className="project-tag">{tag}</Badge>)}</div>
      <h3 id={`project-${index}`}><a href={siteUrl} target="_blank" rel="noopener noreferrer">{title}<ArrowTopRightIcon aria-hidden="true" /></a></h3>
      <p class="project-description">{description}</p>
      <div class="project-links">
        <a class={buttonVariants({ variant: featured ? 'default' : 'outline', size: 'sm' })} href={siteUrl} target="_blank" rel="noopener noreferrer" aria-label={`${title}：${siteLabel}（新しいタブ）`}>{siteLabel}<ArrowTopRightIcon aria-hidden="true" /></a>
        {sourceUrl && <a class={buttonVariants({ variant: 'ghost', size: 'sm' })} href={sourceUrl} target="_blank" rel="noopener noreferrer" aria-label={`${title}のソースコードを新しいタブで開く`}>ソースコード<ArrowTopRightIcon aria-hidden="true" /></a>}
      </div>
    </div>
  </Card>
</article>
