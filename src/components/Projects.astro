---
import ProjectCard from './ProjectCard.astro';
import { ArrowTopRightIcon } from '@radix-ui/react-icons';
import ambot from '@/assets/ambot.jpg';
import iijwidget from '@/assets/iijwidget_gradient.jpg';
import lyricShooter from '@/assets/lyric_shooter_original.png';
import amdlWeb from '@/assets/amdl_web.png';
import iMons from '@/assets/iMonos_compressed.png';

const projects = [
  { title: 'iMons', description: 'Twitter保存ランキングを楽しむためのiOSクライアントです。いちばん使ってもらっている代表作です。', image: iMons, siteUrl: 'https://imons.yyyywaiwai.com/', siteLabel: '公式サイトを見る', tags: ['iOS', 'SwiftUI'], featured: true },
  { title: 'MioWidget', description: 'IIJmioの残データ量をホーム画面で確認するための非公式iOSアプリです。SwiftUIだけで作っています。', image: iijwidget, siteUrl: 'https://apps.apple.com/jp/app/miowidget/id6758489056', siteLabel: 'App Storeで見る', sourceUrl: 'https://github.com/yyyywaiwai/IIJWidget', tags: ['iOS', 'SwiftUI'] },
  { title: 'AMbot', description: 'Apple Musicの好きな曲をそのままDiscordでみんなと楽しむためのBotです。', image: ambot, siteUrl: 'https://discord.com/oauth2/authorize?client_id=1409248906386215002', siteLabel: 'Botを招待する', tags: ['Discord', 'Bot'] },
  { title: 'Lyric Shooter', description: '歌詞を撃つPC向けの2Dシューティングゲームです。', image: lyricShooter, siteUrl: 'https://lyric-shooter.yyyywaiwai.com', sourceUrl: 'https://github.com/yyyywaiwai/lyric-shooter-game', tags: ['Web', 'Game'] },
  { title: 'amdl-web', description: 'Apple Music用のWebダウンローダーです。', image: amdlWeb, siteUrl: 'https://amdl.yyyywaiwai.com', tags: ['Web', 'Tool'] },
];
---

<section id="projects" class="section-block" aria-labelledby="projects-title">
  <div class="section-heading projects-heading">
    <div><h2 id="projects-title">つくったもの</h2><p>日々「ほしい」と思って作った小さなプロジェクトです。</p></div>
    <a class="text-link" href="https://github.com/yyyywaiwai" target="_blank" rel="noopener noreferrer">GitHub<ArrowTopRightIcon aria-hidden="true" /></a>
  </div>
  <div class="project-grid">
    {projects.map((project, index) => <ProjectCard {...project} index={index + 1} />)}
  </div>
</section>
