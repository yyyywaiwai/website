---
import { buttonVariants } from '@/components/ui/button';
import { ArrowRightIcon, ArrowTopRightIcon, ArrowUpIcon, GitHubLogoIcon } from '@radix-ui/react-icons';
import Projects from '@/components/Projects.astro';
import Music from '@/components/Music.astro';
import rickroll from '@/assets/rickroll-roll.gif';
import '@/index.css';

const description = 'iMonsをはじめ、iOSアプリやWebツールを趣味で作るyyyywaiwaiのポートフォリオ。';
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#f8f9f6" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#191d1a" />
    <link rel="icon" type="image/jpeg" href="/icon.jpg" />
    <link rel="canonical" href="https://yyyywaiwai.com/" />
    <title>yyyywaiwai | Personal Lab</title>
    <meta name="description" content={description} />
    <meta property="og:title" content="yyyywaiwai | Personal Lab" />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="yyyywaiwai" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://yyyywaiwai.com/" />
    <meta property="og:locale" content="ja_JP" />
    <meta property="og:image" content="https://yyyywaiwai.com/icon.jpg" />
    <meta property="og:image:alt" content="yyyywaiwaiのアイコン" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:creator" content="@yyyyyy_public" />
  </head>
  <body id="top">
    <a class="skip-link" href="#main-content">本文へ移動</a>
    <header class="site-header">
      <div class="page-width header-inner">
        <div class="brand">
          <button id="avatar-button" class="avatar-button" aria-label="アバター。押すとちょっとしたお楽しみ" title="押してみて" data-rickroll={rickroll.src}>
            <img src="/icon.jpg" alt="" width="34" height="34" />
          </button>
          <a href="#top">yyyywaiwai<span class="brand-note"> / personal lab</span></a>
        </div>
        <nav aria-label="メインナビゲーション">
          <a href="#about" data-nav="about" aria-current="location">About</a>
          <a href="#projects" data-nav="projects">Projects</a>
          <a href="#music" data-nav="music">Music</a>
        </nav>
        <a class="header-github" href="https://github.com/yyyywaiwai" target="_blank" rel="noopener noreferrer"><GitHubLogoIcon aria-hidden="true" />GitHub<ArrowTopRightIcon aria-hidden="true" /></a>
      </div>
    </header>

    <main id="main-content" class="page-width" tabindex="-1">
      <section id="about" class="hero" aria-labelledby="hero-title">
        <div class="hero-copy">
          <h1 id="hero-title">yyyywaiwai<span class="name-period">.</span></h1>
          <p class="hero-description">「こんなのがあったら」と思うiOSアプリやWebツールを、<br />趣味で少しずつ作っています。</p>
          <div class="hero-actions">
            <a class={buttonVariants({ size: 'lg' })} href="#projects">つくったものを見る<ArrowRightIcon aria-hidden="true" /></a>
            <a class={buttonVariants({ variant: 'ghost', size: 'lg' })} href="https://discord.com/invite/DfRhN8uFjX" target="_blank" rel="noopener noreferrer">Discordに参加<ArrowTopRightIcon aria-hidden="true" /></a>
          </div>
        </div>
        <figure class="hero-portrait">
          <img src="/icon.jpg" alt="yyyywaiwaiのプロフィール写真。お皿にのったパンケーキ。" width="399" height="399" fetchpriority="high" />
        </figure>
      </section>

      <Projects />
      <Music />

      <section class="contact-section" aria-labelledby="contact-title">
        <div><h2 id="contact-title">つくったものの話や雑談</h2></div>
        <a class={buttonVariants({ variant: 'outline', size: 'lg' })} href="https://discord.com/invite/DfRhN8uFjX" target="_blank" rel="noopener noreferrer">Discordに参加<ArrowTopRightIcon aria-hidden="true" /></a>
      </section>
    </main>

    <footer class="page-width site-footer">
      <div><a class="footer-brand" href="#top">yyyywaiwai<span class="name-period">.</span></a></div>
      <div class="footer-right">
        <nav aria-label="ソーシャルリンク">
          <a href="https://github.com/yyyywaiwai" target="_blank" rel="noopener noreferrer">GitHub<ArrowTopRightIcon aria-hidden="true" /></a>
          <a href="https://x.com/yyyyyy_public" target="_blank" rel="noopener noreferrer">X<ArrowTopRightIcon aria-hidden="true" /></a>
          <a href="#top">トップへ<ArrowUpIcon aria-hidden="true" /></a>
        </nav>
        <p>© {new Date().getFullYear()} yyyywaiwai</p>
      </div>
    </footer>

    <script>
      const avatar = document.querySelector<HTMLButtonElement>('#avatar-button');
      const portrait = avatar?.querySelector('img');
      if (avatar && portrait) {
        let timer: number;
        const original = portrait.src;
        avatar.addEventListener('click', () => {
          window.clearTimeout(timer);
          const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
          portrait.src = !reduced && avatar.dataset.rickroll ? avatar.dataset.rickroll : original;
          avatar.title = 'You just got rickrolled!';
          avatar.classList.add('is-surprised');
          timer = window.setTimeout(() => {
            portrait.src = original;
            avatar.title = '押してみて';
            avatar.classList.remove('is-surprised');
          }, reduced ? 1500 : 3000);
        });
      }

      if ('IntersectionObserver' in window) {
        const links = document.querySelectorAll<HTMLAnchorElement>('[data-nav]');
        const observer = new IntersectionObserver((entries) => {
          for (const entry of entries) {
            if (!entry.isIntersecting) continue;
            for (const link of links) {
              if (link.dataset.nav === entry.target.id) link.setAttribute('aria-current', 'location');
              else link.removeAttribute('aria-current');
            }
          }
        }, { rootMargin: '-20% 0px -55% 0px' });
        for (const id of ['about', 'projects', 'music']) {
          const section = document.getElementById(id);
          if (section) observer.observe(section);
        }
      }
    </script>
  </body>
</html>
